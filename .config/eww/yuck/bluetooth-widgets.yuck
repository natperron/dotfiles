(defwidget bluetooth-titlecontent []
  (box
    :halign "end"
    :spacing 5
    :space-evenly false
    (eventbox
      :cursor {bluetoothscanning || bluetoothstatus.scanning ? "default" : "pointer"}
      :visible {bluetoothstatus.powered}
      (button
        :class "button scan-button ${bluetoothscanning || bluetoothstatus.scanning ? "disabled" : ""}"
        :tooltip {bluetoothscanning || bluetoothstatus.scanning ? "Scanning..." : "Scan"}
        :active {!(bluetoothscanning || bluetoothstatus.scanning)}
        :width 32
        :height 32
        :onclick "eww update bluetoothscanning=true; ~/.config/eww/scripts/scan-bluetooth.sh &"
        (image
          :class {bluetoothscanning || bluetoothstatus.scanning ? "spinner" : ""}
          :icon "emblem-synchronizing-symbolic"
          :icon-size "menu")))
    (eventbox
      :cursor "pointer"
      (button
        :class "button power-button ${bluetoothstatus.powered ? "on" : ""}"
        :width 32
        :height 32
        :tooltip {bluetoothstatus.powered ? "Power Off" : "Power On"}
        :onclick "bluetoothctl power ${bluetoothstatus.powered ? "off" : "on"}"
        (image :icon "system-shutdown-symbolic" :icon-size "menu")))))

(defwidget bluetooth-content []
  (box
    :vexpand true
    :orientation "vertical"
    :space-evenly false
    (label
      :class "message"
      :visible {!bluetoothstatus.powered}
      :text "Bluetooth is off")
    (label
      :class "message"
      :visible {bluetoothstatus.powered && arraylength(bluetoothdevices) == 0}
      :text "No devices, try scanning")
    (scroll
      :vscroll true
      :vexpand true
      :visible {bluetoothstatus.powered}
      (box
        :class "devices"
        :orientation "vertical"
        :space-evenly false
        :spacing 5
        (for device in bluetoothdevices
          (bluetooth-device :device device))))))

(defwidget bluetooth-device [device]
  (box
    :class "item-card ${bluetoothselected == device.id ? "expanded" : ""}"
    :orientation "vertical"
    :space-evenly false
    (box
      :class "device"
      :space-evenly false
      :spacing 5
      (eventbox
        :cursor "pointer"
        :hexpand true
        :onclick {bluetoothselected == device.id
          ? "eww update bluetoothselected="
          : "eww update bluetoothselected=${device.id}"}
        (box
          :space-evenly false
          :spacing 8
          (image :icon {device.icon})
          (label
            :halign "start"
            :hexpand true
            :truncate true
            :text {device.name})
          (label
            :class "battery"
            :visible {device.battery != ""}
            :text "${device.battery_icon} ${device.battery}%")))
      (eventbox
        :cursor {bluetoothbusy == device.id ? "default" : "pointer"}
        (button
          :class "button text-button ${(bluetoothbusy == device.id ? bluetoothbusylabel == "Disconnecting..." : device.connected) ? "disconnect-button" : ""} ${bluetoothbusy == device.id ? "disabled" : ""}"
          :height 32
          :active {bluetoothbusy != device.id}
          ; The busy label and style are picked on click, device.connected flips before the button is re-enabled
          :onclick "eww update bluetoothbusy=${device.id} bluetoothbusylabel=${device.connected ? "Disconnecting..." : "Connecting..."}; ~/.config/eww/scripts/toggle-bluetooth-device.sh ${device.id} &"
          {bluetoothbusy == device.id
            ? bluetoothbusylabel
            : (device.connected ? "Disconnect" : device.paired ? "Connect" : "Pair")})))
    (revealer
      :transition "slidedown"
      :reveal {bluetoothselected == device.id}
      (box
        :class "item-details"
        :orientation "vertical"
        :spacing 5
        :space-evenly false
        (label
          :halign "start"
          :text "MAC Address: ${device.id}")
        (eventbox
          :cursor "pointer"
          :halign "end"
          :visible {device.paired}
          (button
            :class "button text-button forget-button"
            :height 32
            :onclick "bluetoothctl remove ${device.id}"
            "Forget"))))))
