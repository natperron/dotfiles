(deflisten workspaces `~/.config/eww/scripts/listen-workspaces.sh`)
(deflisten mode `~/.config/eww/scripts/listen-mode.sh`)
(deflisten window `~/.config/eww/scripts/listen-window.sh`)
(deflisten player `~/.config/eww/scripts/listen-player.sh`)
(deflisten battery `~/.config/eww/scripts/listen-battery.sh`)
(deflisten bluetoothstatus :initial '{"icon":"bluetooth-offline","powered":false,"scanning":false}' `~/.config/eww/scripts/listen-bluetooth-status.sh`)
(deflisten bluetoothdevices :initial '[]' `~/.config/eww/scripts/listen-bluetooth-devices.sh`)
(deflisten audio :initial '{"sink":{"id":"","volume":0,"muted":true,"icon":"audio-volume-muted"},"source":{"id":"","volume":0,"muted":true},"sinks":[],"sources":[],"playback":[],"recording":[],"cards":[]}' `~/.config/eww/scripts/listen-audio.sh`)
(deflisten brightness `~/.config/eww/scripts/listen-brightness-status.sh`)
(defpoll datetime :interval "1s" "date +'%b %d, %H:%M'")
(defvar batterypercent false)
(defvar tray false)
(defvar bluetoothselected "")
(defvar bluetoothscanning false)
(defvar bluetoothbusy "")
(defvar audioselected "")
(defvar audioexpanded "")
(defvar audioview "devices")
(defvar audioappsexpanded "playback")
(defvar audioappselected "")
