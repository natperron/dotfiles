(defwidget systemwidget [monitor body title ?titlecontent]
  (box
    :class "window"
    :orientation "vertical"
    :space-evenly false
    (systemwidget-title :title title :titlecontent titlecontent)
    (literal :vexpand true :content body)))

(defwidget systemwidget-title [title ?titlecontent]
  (box
    :class "header"
    :valign "start"
    :space-evenly false
    :spacing 5
    (label
      :class "title"
      :halign "start"
      :hexpand true
      :text title)
    (literal :content titlecontent)))

; Clickable section title, shows a summary (e.g. the default device) when collapsed
(defwidget section-header [title summary expanded onclick]
  (eventbox
    :cursor "pointer"
    :onclick onclick
    (box
      :class "section-header"
      :space-evenly false
      :spacing 8
      (label
        :class "section-title"
        :text title)
      (label
        :class "summary"
        :halign "start"
        :hexpand true
        :truncate true
        :visible {!expanded}
        :text summary)
      (label
        :class "chevron"
        :halign "end"
        :hexpand expanded
        :text {expanded ? "󰅃" : "󰅀"}))))
